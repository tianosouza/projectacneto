# MODELO dos segredos de producao da API no Fly.io (app do backend). NAO coloque valores reais neste arquivo.
# 1. Copie para `.env.fly` (ja ignorado pelo git e pelo Docker): Copy-Item .env.fly.example .env.fly
# 2. Preencha os valores em `.env.fly`.
# 3. Envie ao Fly (o filtro ignora comentarios e linhas vazias; passar como argumentos evita o BOM do pipe no PowerShell):
#    $pairs = Get-Content .env.fly -Encoding UTF8 | ForEach-Object { $_.Trim() } | Where-Object { $_ -match '^[A-Za-z_][A-Za-z0-9_]*=.+' }
#    fly secrets set $pairs -a <nome-da-api>
# 4. Apague o `.env.fly` depois de enviar, ou nao o inclua ao entregar o projeto.

# OBRIGATORIO: 32+ caracteres aleatorios. Sem aspas.
AUTH_SECRET=troque-por-32-ou-mais-caracteres-aleatorios

# OBRIGATORIO: 12+ caracteres (menos que isso a API nao inicia). E a senha de login do admin (ADMIN_EMAIL). Sem aspas.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# OPCIONAL: 12+ caracteres. Cria o superadmin (admin@admin.com). Apague a linha se nao quiser. Sem aspas.
SUPERADMIN_PASSWORD=
