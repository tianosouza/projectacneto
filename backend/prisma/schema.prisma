generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  phone        String?
  birthDate    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile Profile?
  driver  Driver?
  transportCompany TransportCompany? @relation("CompanyAccount")
  registrationAttachments RegistrationAttachment[]
  changeRequests AccountChangeRequest[]
  passwordResetTokens PasswordResetToken[]
  driverChatMessages DriverChatMessage[]
  createdFreightRoutes FreightRoute[] @relation("FreightRouteCreator")
  createdFreightOffers FreightChatOffer[] @relation("FreightChatOfferCreator")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String?
  role      String   @default("driver")
  fullName  String?
  requestedRole String  @default("driver")
  registrationNotes String?
  approved  Boolean  @default(false)
  approvalClosed Boolean @default(false)
  mustChangePassword Boolean @default(false)
  isSuperAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company TransportCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, approved])
}

model RegistrationAttachment {
  id         String   @id @default(cuid())
  userId     String
  name       String
  mimeType   String
  dataBase64 String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Driver {
  id               String    @id @default(cuid())
  userId           String    @unique
  fullName         String
  cpf              String?   @unique
  phone            String?
  email            String?
  vehicleModel     String?
  vehicleYear      Int?
  capacity         String?
  compartments     String?
  plate            String?
  cnh              String?   @unique
  cnhCategory      String?
  cnhExpiresAt     DateTime?
  city             String?
  state            String?
  homologationStatus String   @default("in_analysis")
  locationSharingAuthorized Boolean @default(false)
  isOnline         Boolean   @default(false)
  latitude         Float?
  longitude        Float?
  lastSeen         DateTime?
  status           String    @default("offline")
  notes            String?
  employmentType   String    @default("autonomous")
  availabilitySince DateTime?
  availabilityCity String?
  availabilityAt DateTime?
  rating           Float     @default(0)
  totalTrips       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  ownedVehicles Vehicle[] @relation("OwnedVehicles")
  vehicleAssignments VehicleDriverAssignment[]
  carrierLinks DriverCarrierLink[]
  documents HomologationDocument[]
  chatMessages DriverChatMessage[]
  routeAssignments FreightRouteAssignment[]
  freightOffers FreightChatOffer[]

  @@index([status])
  @@index([isOnline])
  @@index([city, state])
  @@index([availabilitySince])
}

model DriverChatMessage {
  id        String   @id @default(cuid())
  driverId  String
  userId    String
  freightOfferId String? @unique
  body      String
  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  freightOffer FreightChatOffer? @relation(fields: [freightOfferId], references: [id], onDelete: SetNull)

  @@index([driverId, createdAt])
  @@index([userId, createdAt])
}

model OperationalLocation {
  id          String   @id @default(cuid())
  kind        String   // collection_point or final_customer
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  latitude    Float?
  longitude   Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyAccesses        OperationalLocationCompanyAccess[]
  collectionRoutes       FreightRoute[] @relation("FreightRouteCollectionPoint")
  customerRoutes         FreightRoute[] @relation("FreightRouteFinalCustomer")

  @@index([kind, active])
  @@index([city, state])
}

model OperationalLocationCompanyAccess {
  id         String   @id @default(cuid())
  locationId String
  companyId  String
  createdAt  DateTime @default(now())

  location OperationalLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  company  TransportCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([locationId, companyId])
  @@index([companyId])
}

model AccountChangeRequest {
  id               String   @id @default(cuid())
  userId           String
  requestedChanges String
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TransportCompany {
  id        String   @id @default(cuid())
  userId    String?  @unique
  legalName String
  cnpj      String   @unique
  stateRegistration String?
  phone     String
  address   String
  email     String
  status    String   @default("in_analysis")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account User? @relation("CompanyAccount", fields: [userId], references: [id], onDelete: SetNull)
  profiles Profile[]
  vehicles Vehicle[] @relation("CompanyVehicles")
  driverLinks DriverCarrierLink[]
  documents HomologationDocument[]
  locationAccesses OperationalLocationCompanyAccess[]

  @@index([status])
}

model Vehicle {
  id          String   @id @default(cuid())
  companyId   String?
  ownerDriverId String?
  type        String
  plate       String   @unique
  capacity    String?
  compartments String?
  productType String?
  homologationStatus String @default("in_analysis")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     TransportCompany? @relation("CompanyVehicles", fields: [companyId], references: [id], onDelete: SetNull)
  ownerDriver Driver? @relation("OwnedVehicles", fields: [ownerDriverId], references: [id], onDelete: SetNull)
  driverAssignments VehicleDriverAssignment[]
  products    VehicleProduct[]
  documents HomologationDocument[]

  @@index([companyId])
  @@index([ownerDriverId])
  @@index([homologationStatus])
}

model VehicleDriverAssignment {
  id        String   @id @default(cuid())
  vehicleId String
  driverId  String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  status    String   @default("active")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([vehicleId, endedAt])
  @@index([driverId, endedAt])
}

model DriverCarrierLink {
  id        String   @id @default(cuid())
  driverId  String
  companyId String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  status    String   @default("active")

  driver  Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  company TransportCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([driverId, endedAt])
  @@index([companyId, endedAt])
}

model VehicleProduct {
  id        String   @id @default(cuid())
  vehicleId String
  product   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, product])
}

model HomologationDocument {
  id          String   @id @default(cuid())
  driverId    String?
  vehicleId   String?
  companyId   String?
  documentType String
  fileName    String?
  status      String   @default("pending")
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  company TransportCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
  @@index([vehicleId, status])
  @@index([companyId, status])
}

// Rota de transporte: pode ter vários motoristas ao longo do tempo (histórico),
// mas cada motorista só pode ter um vínculo (assignment) ativo por vez.
model FreightRoute {
  id                String    @id @default(cuid())
  createdByUserId   String
  collectionPointId String
  finalCustomerId   String
  distanceKm        Float?
  status            String    @default("open") // open, assigned, in_progress, completed, cancelled
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy       User                @relation("FreightRouteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  collectionPoint OperationalLocation @relation("FreightRouteCollectionPoint", fields: [collectionPointId], references: [id], onDelete: Restrict)
  finalCustomer   OperationalLocation @relation("FreightRouteFinalCustomer", fields: [finalCustomerId], references: [id], onDelete: Restrict)
  assignments     FreightRouteAssignment[]
  chatOffers      FreightChatOffer[]

  @@index([status, createdAt])
  @@index([collectionPointId])
  @@index([finalCustomerId])
}

model FreightRouteAssignment {
  id         String    @id @default(cuid())
  routeId    String
  driverId   String
  capacity   String?
  status     String    @default("active") // active, completed, cancelled
  progressStatus String @default("assigned") // assigned, en_route_collection, awaiting_collection_confirmation, collection_confirmed, en_route_customer, awaiting_customer_confirmation, completed
  acceptedAt DateTime  @default(now())
  endedAt    DateTime?
  collectionArrivedAt DateTime?
  collectionConfirmedAt DateTime?
  customerArrivedAt DateTime?
  customerConfirmedAt DateTime?

  route  FreightRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  settlement FreightSettlement?
  chatOffer FreightChatOffer?

  @@index([routeId, status])
  @@index([driverId, status])
}

model FreightChatOffer {
  id                   String   @id @default(cuid())
  routeId              String
  driverId             String
  createdByUserId      String
  amountCents          Int
  status               String   @default("offered") // offered, accepted, rejected, completed
  createdAt            DateTime @default(now())
  respondedAt          DateTime?
  acceptedAssignmentId String?  @unique

  route               FreightRoute          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver              Driver                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  createdBy           User                  @relation("FreightChatOfferCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  message             DriverChatMessage?
  acceptedAssignment  FreightRouteAssignment? @relation(fields: [acceptedAssignmentId], references: [id], onDelete: SetNull)

  @@index([driverId, status, createdAt])
  @@index([routeId, createdAt])
}

model FreightSettlement {
  id                           String   @id @default(cuid())
  assignmentId                 String   @unique
  driverClaimedAmountCents     Int?
  confirmedAmountCents         Int?
  driverNotes                  String?
  operationsNotes              String?
  paymentReference             String?
  paymentProofFileName         String?
  paymentProofMimeType         String?
  paymentProofDataBase64       String?
  status                       String   @default("pending") // pending, approved, paid
  approvedAt                   DateTime?
  paidAt                       DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  assignment FreightRouteAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}
